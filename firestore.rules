rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /master_plans/{planId} {
      allow read: if true; // Publicly readable so the published app loads with info immediately
      allow write: if true; // In the iframe / dev environment, let's allow writing the data so they can publish from the UI

      match /actividades/{actividadId} {
        allow read: if true;
        allow write: if true;
      }

      match /planillaHojas/{itemId} {
        allow read: if true;
        allow write: if true;
      }

      match /planillaPartidas/{itemId} {
        allow read: if true;
        allow write: if true;
      }

      match /cdo_vs_sabana_F/{itemId} {
        allow read: if true;
        allow write: if true;
      }

      match /cdo_vs_sabana_H/{itemId} {
        allow read: if true;
        allow write: if true;
      }
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    match /system_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    match /ai_reports/{reportId} {
      allow read: if true;
      allow write: if true;
    }

    match /personal_plans/{planId} {
      allow read: if true;
      allow write: if true;

      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if true;
      }
    }

    match /test/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
