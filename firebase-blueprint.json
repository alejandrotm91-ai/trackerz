{
  "entities": {
    "MasterPlanMeta": {
      "title": "MasterPlanMeta",
      "description": "Metadata and global totals/configurations of the loaded Master Plan",
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "description": "The name of the uploaded Excel file"
        },
        "rowCount": {
          "type": "number",
          "description": "Number of rows in the main CDO sheet"
        },
        "periodoSeleccionado": {
          "type": "object",
          "description": "The active selected report period"
        },
        "fechaCorteState": {
          "type": "string",
          "description": "The ISO string of the cut-off date"
        },
        "mapaColumnasMes": {
          "type": "object",
          "description": "Month to column indices map"
        },
        "planillaInfo": {
          "type": "object",
          "description": "Metadata about sheets in the Planilla"
        },
        "planillaTotales": {
          "type": "object",
          "description": "Totals for Planilla sheets"
        },
        "planillaCDOvsS": {
          "type": "object",
          "description": "CDO vs Sabana alignment and comparison map"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when this plan was uploaded"
        }
      },
      "required": ["fileName", "rowCount", "updatedAt"]
    },
    "Actividad": {
      "title": "Actividad",
      "description": "An individual WBS activity/package from the CDO and pg-003 sheets",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "wbs": {
          "type": "string"
        },
        "activityId": {
          "type": "string"
        },
        "descripcion": {
          "type": "string"
        },
        "unidad": {
          "type": "string"
        },
        "nivel": {
          "type": "number"
        },
        "esItemHoja": {
          "type": "boolean"
        },
        "venta": {
          "type": "number"
        },
        "ventaPlan": {
          "type": "number"
        },
        "ventaEjecutada": {
          "type": "number"
        },
        "balance": {
          "type": "number"
        },
        "saldo": {
          "type": "number"
        },
        "tipo": {
          "type": "string"
        },
        "subcontratista": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "certificacionesPorFecha": {
          "type": "object"
        }
      },
      "required": ["id", "wbs", "descripcion", "nivel", "esItemHoja"]
    },
    "PlanillaItem": {
      "title": "PlanillaItem",
      "description": "A row item inside the Planilla sheets",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "cod": {
          "type": "string"
        },
        "nivel": {
          "type": "number"
        },
        "esHoja": {
          "type": "boolean"
        },
        "desc": {
          "type": "string"
        },
        "unidad": {
          "type": "string"
        },
        "tarifa": {
          "type": "number"
        },
        "contrato": {
          "type": "number"
        },
        "saldo": {
          "type": "number"
        },
        "acum": {
          "type": "number"
        },
        "cert": {
          "type": "number"
        }
      },
      "required": ["id", "cod", "nivel", "esHoja", "desc"]
    },
    "MasterCdoPlan": {
      "title": "MasterCdoPlan",
      "description": "Master CDO Plan document hosting weekly work advance and economic calculation",
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "description": "Name of the source or master file"
        },
        "totalRows": {
          "type": "number",
          "description": "Total number of items in the CDO master"
        },
        "semanas": {
          "type": "array",
          "description": "Weekly period cut-offs and metadata"
        },
        "totales": {
          "type": "object",
          "description": "Calculated totals for budget, executed and balance"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last modification"
        }
      },
      "required": ["fileName", "totalRows", "updatedAt"]
    }
  },
  "firestore": {
    "/master_cdo_plans/{planId}": {
      "schema": "MasterCdoPlan",
      "description": "Online live CDO master plan document"
    },
    "/master_cdo_plans/{planId}/chunks/{chunkId}": {
      "type": "object",
      "description": "Chunks containing Master CDO activity items and weekly progress"
    },
    "/master_plans/{planId}": {
      "schema": "MasterPlanMeta",
      "description": "Document hosting global state, config, and metadata"
    },
    "/master_plans/{planId}/actividades/{actividadId}": {
      "schema": "Actividad",
      "description": "All activities belonging to the master plan"
    },
    "/master_plans/{planId}/planillaHojas/{itemId}": {
      "schema": "PlanillaItem",
      "description": "Planilla sheets' structural rows"
    },
    "/master_plans/{planId}/planillaPartidas/{itemId}": {
      "schema": "PlanillaItem",
      "description": "Planilla leaf items"
    },
    "/master_plans/{planId}/cdo_vs_sabana_F/{itemId}": {
      "type": "object",
      "description": "CDO vs Sabana aligned Comparison Tree (F - Chapter hierarchy)"
    },
    "/master_plans/{planId}/cdo_vs_sabana_H/{itemId}": {
      "type": "object",
      "description": "CDO vs Sabana aligned Comparison Tree (H - Item hierarchy)"
    },
    "/config/{configId}": {
      "type": "object",
      "description": "Global custom configurations such as Google Drive enlazado files"
    },
    "/ai_reports/{reportId}": {
      "type": "object",
      "description": "Generated AI reports"
    }
  }
}
